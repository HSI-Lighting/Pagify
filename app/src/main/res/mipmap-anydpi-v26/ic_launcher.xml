<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      No <monochrome> layer on purpose. A themed icon is tinted from the
      drawable's alpha, and this mark's alpha is its outer silhouette — the
      counter of the P, the document rules and the arrow would all fill in,
      leaving a featureless blob. Omitting it lets the launcher fall back to a
      standard treatment instead.
    -->
</adaptive-icon>
