<?xml version="1.0" encoding="utf-8"?>
<!--
  Pagify mark: a green "P" with a leaf, a PDF sheet, and a swoosh arrow from the
  one to the other.

  Redrawn as vector paths rather than traced from the supplied PNG, which was
  pasted into chat and never reached the filesystem. `tools/make_icon.ps1`
  regenerates every density from that PNG if it is ever saved to disk.

  All artwork sits inside the 66dp safe circle of the 108dp adaptive canvas
  (roughly x,y in 21..87), so no launcher mask - circle, squircle or squircle
  with a tight radius - can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ============================ PDF sheet ============================ -->
    <!-- Body, with the top-right corner cut away for the fold. -->
    <path
        android:fillColor="#FAFAF8"
        android:pathData="M55,28 h17 l12,12 v44 a3,3 0 0 1 -3,3 h-26 a3,3 0 0 1 -3,-3 v-53 a3,3 0 0 1 3,-3 z" />
    <!-- The fold itself, darker so the corner reads as turned. -->
    <path
        android:fillColor="#C9D2C4"
        android:pathData="M72,28 l12,12 h-12 z" />

    <!-- "PDF" label block. -->
    <path
        android:fillColor="#6E7A68"
        android:pathData="M59,43 h17 a2,2 0 0 1 2,2 v7 a2,2 0 0 1 -2,2 h-17 a2,2 0 0 1 -2,-2 v-7 a2,2 0 0 1 2,-2 z" />

    <!-- Ruled lines of body text. -->
    <path
        android:fillColor="#BFC7BC"
        android:pathData="M58,60 h20 v3 h-20 z M58,67 h20 v3 h-20 z M58,74 h13 v3 h-13 z" />

    <!-- ============================ swoosh =============================== -->
    <!-- Sweeps up from behind the P and points into the sheet. -->
    <path
        android:fillColor="#7FB539"
        android:pathData="M36,80 c3,-11 12,-19 24,-21 v-7 l14,10 -14,10 v-7 c-9,2 -15,8 -17,16 z" />

    <!-- ============================== P ================================== -->
    <!-- Even-odd fill: the second subpath punches the counter out of the bowl. -->
    <path
        android:fillColor="#6FAF20"
        android:fillType="evenOdd"
        android:pathData="M24,24 h17 a16,16 0 0 1 0,32 h-7 v28 h-10 z
                          M34,33 h7 a7,7 0 0 1 0,14 h-7 z" />

    <!-- Leaf tucked into the foot of the stem. -->
    <path
        android:fillColor="#8CC63E"
        android:pathData="M24,84 c0,-9 7,-16 16,-16 c0,9 -7,16 -16,16 z" />
</vector>
