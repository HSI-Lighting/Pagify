<?xml version="1.0" encoding="utf-8"?>
<!--
    What the capture FileProvider is allowed to hand out.

    Exactly one directory, inside our own cache. Sharing a broader path — or the
    whole of cacheDir — would let any app we share one capture with resolve a URI
    for a document the user never meant to send.
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <!--
        Contacts get their own directory rather than sharing the captures one.
        A vCard and a page image are shared with different apps for different
        reasons, and one grant should never reach the other kind of file.
    -->
    <cache-path name="contacts" path="contacts/" />
    <!--
        And card photographs their own again. A photo taken to be read is
        handed to nobody; it is here only because the camera app needs
        somewhere to write, and it should not be reachable through a grant
        given out for a vCard or a page.
    -->
    <cache-path name="cards" path="cards/" />
</paths>
