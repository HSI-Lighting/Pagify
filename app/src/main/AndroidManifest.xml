<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saving a capture to the gallery. Needed only below API 29: from there on
         MediaStore's scoped storage lets an app insert an image and write it
         through the URI it gets back, touching nothing outside its own sandbox. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Reminders. POST_NOTIFICATIONS is requested at the moment a reminder is
         first set rather than on launch, so it arrives with a reason attached;
         RECEIVE_BOOT_COMPLETED is what lets a reminder survive a restart, and
         without it they stop silently at the first reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A meeting reminder rings like an alarm, and these are what let it.

         USE_EXACT_ALARM rather than SCHEDULE_EXACT_ALARM: the latter is granted
         in a settings screen and can be refused, which would leave an alarm
         going off whenever the system next felt like waking up. This one is
         granted at install and cannot be taken away, and it is the permission
         meant for exactly this — an alert the user set for a stated minute.

         USE_FULL_SCREEN_INTENT is what puts the alarm screen in front of a
         locked phone. From Android 14 it can be revoked, so the code asks
         before relying on it rather than assuming, and falls back to a
         notification that carries the alarm tone itself. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The ringing runs in a foreground service, because that is the one thing
         an app handling an alarm broadcast is reliably allowed to start. It is
         not allowed to start an activity: with the app closed, Android answers
         a background activity launch with BAL_BLOCK, which is why the alarm
         screen only ever appeared while the app was already open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".PagifyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pagify">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Pagify">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer Pagify when the user opens a PDF from mail, a browser
                 download, or a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Offer Pagify for a CAD drawing or model the same way — but
                 these have no registered MIME type the way a PDF does, so
                 matching on mimeType alone is the wrong tool here.

                 A `content://` URI from a real document provider (Drive,
                 Gmail's attachment viewer) usually DOES resolve a type, so
                 that half is covered by the literal `mimeType` entries below.
                 A `file://` URI from a plain file manager usually does not —
                 Android's own `MimeTypeMap` has never heard of a .dwg or a
                 .step file, so `intent.type` arrives null and a filter that
                 only looks at mimeType never sees the file at all. That half
                 is covered by matching on the file's own name instead, via
                 `pathPattern`, with `mimeType="*/*"` standing in for "I do
                 not care what the provider resolved, if anything."

                 `pathPattern`'s matching here is a strict, literal glob with
                 no character classes and no alternation (`android:pathSuffix`
                 would be the clean version of this, but it needs API 31 and
                 this app's minSdk is 24) — so each extension gets two
                 entries, lower and upper case, rather than one pattern
                 covering both. Real files come in both. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- A provider that resolved a real type. These are not an
                     IANA-registered set — DWG and DXF predate MIME entirely —
                     so this is every spelling actually seen in the wild
                     (freedesktop's shared-mime-info, which a number of Android
                     file managers build their type tables from, and a few
                     vendor variants beside it). -->
                <data android:mimeType="image/vnd.dwg" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="application/x-acad" />
                <data android:mimeType="application/x-dwg" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="application/x-dxf" />
                <data android:mimeType="model/step" />
                <data android:mimeType="application/step" />
                <data android:mimeType="application/x-step" />
                <data android:mimeType="model/step-xml+zip" />

                <!-- A provider that didn't, matched on the file's own name
                     instead. -->
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.dwg" />
                <data android:pathPattern=".*\\.DWG" />
                <data android:pathPattern=".*\\.dxf" />
                <data android:pathPattern=".*\\.DXF" />
                <data android:pathPattern=".*\\.step" />
                <data android:pathPattern=".*\\.STEP" />
                <data android:pathPattern=".*\\.stp" />
                <data android:pathPattern=".*\\.STP" />
                <data android:pathPattern=".*\\.p21" />
                <data android:pathPattern=".*\\.P21" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Hands out one capture at a time as a content:// URI. Not exported: a
             receiving app reads it only through the grant that travels with the
             share intent, and only for the one file named in it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <!-- The alarm going off, and the phone coming back on. Not exported:
             nothing outside the app has any business firing these. -->
        <!-- The alarm face. Its own task and out of recents, so answering a
             meeting alert never leaves a stray screen behind the app; and
             `showOnLockScreen` so it is visible without the phone being
             unlocked, which is the entire point of it. -->
        <activity
            android:name=".core.ReminderAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=".alarm"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Pagify" />

        <!-- `shortService` because the ring stops itself at two minutes, inside
             the roughly three this type allows, and because it is the one
             foreground service type that asks the user for no permission. -->
        <service
            android:name=".core.ReminderAlarmService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <receiver
            android:name=".core.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hsilighting.pagify.REMINDER" />
                <action android:name="com.hsilighting.pagify.REMINDER_DONE" />
                <action android:name="com.hsilighting.pagify.REMINDER_SNOOZE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
