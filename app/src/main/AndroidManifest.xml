<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saving a capture to the gallery. Needed only below API 29: from there on
         MediaStore's scoped storage lets an app insert an image and write it
         through the URI it gets back, touching nothing outside its own sandbox. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Reminders. POST_NOTIFICATIONS is requested at the moment a reminder is
         first set rather than on launch, so it arrives with a reason attached;
         RECEIVE_BOOT_COMPLETED is what lets a reminder survive a restart, and
         without it they stop silently at the first reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PagifyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pagify">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Pagify">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer Pagify when the user opens a PDF from mail, a browser
                 download, or a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Hands out one capture at a time as a content:// URI. Not exported: a
             receiving app reads it only through the grant that travels with the
             share intent, and only for the one file named in it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <!-- The alarm going off, and the phone coming back on. Not exported:
             nothing outside the app has any business firing these. -->
        <receiver
            android:name=".core.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hsilighting.pagify.REMINDER" />
                <action android:name="com.hsilighting.pagify.REMINDER_DONE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
